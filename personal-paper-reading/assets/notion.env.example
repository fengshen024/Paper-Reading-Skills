# Copy this file to a private location and fill in your own values.
# Credentials are read locally; never paste the real token into a chat.
NOTION_TOKEN=your_internal_connection_token_or_personal_access_token

# Option A: create each paper note under this ordinary Notion page.
# A full page URL or a UUID is accepted.
NOTION_PARENT_PAGE_ID=your_parent_page_url_or_id

# Option B: create each paper as a separate database record page.
# A copied database URL is accepted; the sole data source is resolved automatically.
# Remove/comment NOTION_PARENT_PAGE_ID first.
# NOTION_DATABASE_ID=your_database_url_or_uuid

# Option B2: choose a data source explicitly, e.g. a database containing several sources.
# Remove/comment NOTION_DATABASE_ID as well when choosing this mode.
# This must be a data source ID, not a database URL or view ID.
# NOTION_DATA_SOURCE_ID=your_data_source_uuid

# Option C: create independent private pages at the workspace root.
# Requires a PAT or user-authorized public connection; internal tokens cannot do this.
# Remove/comment NOTION_PARENT_PAGE_ID, NOTION_DATABASE_ID and NOTION_DATA_SOURCE_ID first.
# The workspace is determined by the token, not a page URL or workspace ID.
# NOTION_WORKSPACE_ROOT=true
